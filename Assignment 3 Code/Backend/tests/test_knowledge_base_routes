import io
import unittest
from unittest.mock import AsyncMock, patch

from fastapi import HTTPException, UploadFile

from app.api.routes.knowledge_base import (
    MAX_UPLOAD_BYTES,
    parse_uploaded_formulas,
    upload_knowledge_base,
    validate_knowledge_base,
)
from app.schemas.knowledge_base import ValidationPayload
from app.schemas.project import Project


class UploadedFormulaParsingTests(unittest.TestCase):
    def test_parses_json_formula_array(self):
        formulas, query = parse_uploaded_formulas("kb.json", '["P", "(P -> Q)"]')
        self.assertEqual(formulas, ["P", "(P -> Q)"])
        self.assertIsNone(query)

    def test_parses_json_object_and_query(self):
        formulas, query = parse_uploaded_formulas(
            "kb.json", '{"knowledge_base":["P"],"goal":"Q"}'
        )
        self.assertEqual(formulas, ["P"])
        self.assertEqual(query, "Q")

    def test_parses_line_based_files_and_ignores_comments(self):
        formulas, query = parse_uploaded_formulas("kb.kb", "# comment\nP\n\n(P -> Q)\n")
        self.assertEqual(formulas, ["P", "(P -> Q)"])
        self.assertIsNone(query)

    def test_rejects_malformed_json(self):
        with self.assertRaises(HTTPException) as raised:
            parse_uploaded_formulas("kb.json", "{")
        self.assertEqual(raised.exception.status_code, 400)

    def test_rejects_non_string_json_formula(self):
        with self.assertRaises(HTTPException) as raised:
            parse_uploaded_formulas("kb.json", '{"formulas":["P",2]}')
        self.assertEqual(raised.exception.status_code, 422)

    def test_rejects_non_string_query(self):
        with self.assertRaises(HTTPException) as raised:
            parse_uploaded_formulas("kb.json", '{"formulas":["P"],"query":2}')
        self.assertEqual(raised.exception.status_code, 422)


class KnowledgeBaseRouteTests(unittest.IsolatedAsyncioTestCase):
    async def test_validation_reports_valid_and_invalid_formulas(self):
        result = await validate_knowledge_base(
            ValidationPayload(formulas=["P", "P ->"]), session_id="session-1"
        )
        self.assertFalse(result.valid)
        self.assertTrue(result.results[0].valid)
        self.assertFalse(result.results[1].valid)

    async def test_upload_rejects_unsupported_extension(self):
        file = UploadFile(filename="kb.csv", file=io.BytesIO(b"P"))
        with self.assertRaises(HTTPException) as raised:
            await upload_knowledge_base("project-1", file, "session-1")
        self.assertEqual(raised.exception.status_code, 415)

    async def test_upload_rejects_file_over_five_megabytes(self):
        file = UploadFile(filename="kb.txt", file=io.BytesIO(b"P" * (MAX_UPLOAD_BYTES + 1)))
        with self.assertRaises(HTTPException) as raised:
            await upload_knowledge_base("project-1", file, "session-1")
        self.assertEqual(raised.exception.status_code, 413)

    async def test_upload_rejects_empty_file(self):
        file = UploadFile(filename="kb.txt", file=io.BytesIO(b""))
        with self.assertRaises(HTTPException) as raised:
            await upload_knowledge_base("project-1", file, "session-1")
        self.assertEqual(raised.exception.status_code, 422)

    async def test_upload_rejects_invalid_formula_without_saving(self):
        file = UploadFile(filename="kb.txt", file=io.BytesIO(b"P ->"))
        save = AsyncMock()
        with patch("app.api.routes.knowledge_base.project_manager.set_knowledge_base", save):
            with self.assertRaises(HTTPException) as raised:
                await upload_knowledge_base("project-1", file, "session-1")
        self.assertEqual(raised.exception.status_code, 422)
        save.assert_not_awaited()

    async def test_valid_upload_saves_formulas_and_uploaded_query(self):
        file = UploadFile(
            filename="kb.json",
            file=io.BytesIO(b'{"formulas":["P","P -> Q"],"query":"Q"}'),
        )
        project = Project(project_id="project-1", knowledge_base=["P", "(P -> Q)"])
        set_kb = AsyncMock(return_value=project)
        set_goal = AsyncMock(side_effect=lambda _session, _project, goal: Project(
            project_id="project-1", knowledge_base=project.knowledge_base, goal=goal
        ))
        with patch("app.api.routes.knowledge_base.project_manager.set_knowledge_base", set_kb), patch(
            "app.api.routes.knowledge_base.project_manager.set_goal", set_goal
        ):
            response = await upload_knowledge_base("project-1", file, "session-1")
        self.assertEqual([str(item) for item in response.formulas], ["P", "(P -> Q)"])
        self.assertEqual(str(response.goal), "Q")
        set_kb.assert_awaited_once()
        set_goal.assert_awaited_once()


if __name__ == "__main__":
    unittest.main()
